    <bpmn:sequenceFlow id="Flow_BookingInvalidEnd" sourceRef="Task_ShowBookingValidationError" targetRef="EndEvent_BookingInvalid" />
    <bpmn:sequenceFlow id="Flow_SubmitToGateway" sourceRef="Task_SubmitBookingRequest" targetRef="Gateway_PostSubmit" />
    <bpmn:sequenceFlow id="Flow_ToAdminReview" name="Admin reviews" sourceRef="Gateway_PostSubmit" targetRef="Task_OpenValidationsQueue" />
    <bpmn:sequenceFlow id="Flow_ToStudentCancel" name="Student cancels" sourceRef="Gateway_PostSubmit" targetRef="Task_ViewHistory" />
    <bpmn:sequenceFlow id="Flow_ToTimer" name="48h pass" sourceRef="Gateway_PostSubmit" targetRef="IntermediateTimer_48h" />
    <bpmn:sequenceFlow id="Flow_HistoryToCancel" sourceRef="Task_ViewHistory" targetRef="Task_CancelWithJustification" />
    <bpmn:sequenceFlow id="Flow_CancelToEnd" sourceRef="Task_CancelWithJustification" targetRef="EndEvent_CancelledByStudent" />
    <bpmn:sequenceFlow id="Flow_TimerToEnd" sourceRef="IntermediateTimer_48h" targetRef="EndEvent_AutoCancelled" />
    <bpmn:sequenceFlow id="Flow_OpenQueueToReview" sourceRef="Task_OpenValidationsQueue" targetRef="Task_AdminReviewBooking" />
    <bpmn:sequenceFlow id="Flow_ReviewToDecision" sourceRef="Task_AdminReviewBooking" targetRef="Gateway_AdminDecision" />
    <bpmn:sequenceFlow id="Flow_AdminApprove" name="Yes" sourceRef="Gateway_AdminDecision" targetRef="EndEvent_Scheduled" />
    <bpmn:sequenceFlow id="Flow_AdminReject" name="No" sourceRef="Gateway_AdminDecision" targetRef="Task_RejectBooking" />
    <bpmn:sequenceFlow id="Flow_RejectToEnd" sourceRef="Task_RejectBooking" targetRef="EndEvent_Rejected" />
    <bpmn:endEvent id="EndEvent_CancelledByStudent" name="Cancelled_Justified">
      <bpmn:incoming>Flow_CancelToEnd</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Task_CancelWithJustification" name="Cancel with Justification">
      <bpmn:incoming>Flow_HistoryToCancel</bpmn:incoming>
      <bpmn:outgoing>Flow_CancelToEnd</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_ViewHistory" name="View History (session is pending)">
      <bpmn:incoming>Flow_ToStudentCancel</bpmn:incoming>
      <bpmn:outgoing>Flow_HistoryToCancel</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_OpenValidationsQueue" name="Open Validations Queue (Pedidos de coaching)">
      <bpmn:incoming>Flow_ToAdminReview</bpmn:incoming>
      <bpmn:outgoing>Flow_OpenQueueToReview</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_AdminReviewBooking" name="Review Booking Request">
      <bpmn:incoming>Flow_OpenQueueToReview</bpmn:incoming>
      <bpmn:outgoing>Flow_ReviewToDecision</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_AdminDecision" name="Approve?">
      <bpmn:incoming>Flow_ReviewToDecision</bpmn:incoming>
      <bpmn:outgoing>Flow_AdminApprove</bpmn:outgoing>
      <bpmn:outgoing>Flow_AdminReject</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="EndEvent_Scheduled" name="Scheduled">
      <bpmn:incoming>Flow_AdminApprove</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
