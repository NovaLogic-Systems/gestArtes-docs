      <bpmn:lane id="Lane_Student" name="Student">
        <bpmn:flowNodeRef>StartEvent_Need</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ViewSchedule</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_OpenBookingForm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_FillBookingForm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_BookingValidity</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SubmitBookingRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ShowBookingValidationError</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_PostSubmit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IntermediateTimer_48h</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_BookingInvalid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_AutoCancelled</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_CancelledByStudent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CancelWithJustification</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ViewHistory</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Admin" name="Management">
        <bpmn:flowNodeRef>Task_RejectBooking</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_OpenValidationsQueue</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AdminReviewBooking</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_AdminDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Scheduled</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_Need" name="Student needs coaching">
      <bpmn:outgoing>Flow_Start</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_ViewSchedule" name="View Available Schedule">
      <bpmn:incoming>Flow_Start</bpmn:incoming>
      <bpmn:outgoing>Flow_View</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_OpenBookingForm" name="Open New Booking Form">
      <bpmn:incoming>Flow_View</bpmn:incoming>
      <bpmn:outgoing>Flow_OpenFill</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_FillBookingForm" name="Fill Booking Form (teacher, modality, studio, date, time, format)">
      <bpmn:incoming>Flow_OpenFill</bpmn:incoming>
      <bpmn:outgoing>Flow_FillValidate</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_BookingValidity" name="Booking form valid?">
      <bpmn:incoming>Flow_FillValidate</bpmn:incoming>
      <bpmn:outgoing>Flow_BookingValid</bpmn:outgoing>
      <bpmn:outgoing>Flow_BookingInvalid</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_ShowBookingValidationError" name="Show validation error and fix booking form">
      <bpmn:incoming>Flow_BookingInvalid</bpmn:incoming>
      <bpmn:outgoing>Flow_BookingInvalidEnd</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_SubmitBookingRequest" name="Submit Booking Request (Pending_Approval)">
      <bpmn:incoming>Flow_BookingValid</bpmn:incoming>
      <bpmn:outgoing>Flow_SubmitToGateway</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_PostSubmit" name="What occurs first?">
      <bpmn:incoming>Flow_SubmitToGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_ToAdminReview</bpmn:outgoing>
      <bpmn:outgoing>Flow_ToStudentCancel</bpmn:outgoing>
      <bpmn:outgoing>Flow_ToTimer</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateCatchEvent id="IntermediateTimer_48h" name="48h elapsed">
      <bpmn:incoming>Flow_ToTimer</bpmn:incoming>
      <bpmn:outgoing>Flow_TimerToEnd</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerDef_48h" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="EndEvent_AutoCancelled" name="Cancelled (auto, 48h)">
      <bpmn:incoming>Flow_TimerToEnd</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="EndEvent_BookingInvalid" name="Booking validation failed">
      <bpmn:incoming>Flow_BookingInvalidEnd</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Task_RejectBooking" name="Reject with Reason">
      <bpmn:incoming>Flow_AdminReject</bpmn:incoming>
      <bpmn:outgoing>Flow_RejectToEnd</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="EndEvent_Rejected" name="Cancelled_Rejected">
      <bpmn:incoming>Flow_RejectToEnd</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Start" sourceRef="StartEvent_Need" targetRef="Task_ViewSchedule" />
    <bpmn:sequenceFlow id="Flow_View" sourceRef="Task_ViewSchedule" targetRef="Task_OpenBookingForm" />
    <bpmn:sequenceFlow id="Flow_OpenFill" sourceRef="Task_OpenBookingForm" targetRef="Task_FillBookingForm" />
    <bpmn:sequenceFlow id="Flow_FillValidate" sourceRef="Task_FillBookingForm" targetRef="Gateway_BookingValidity" />
