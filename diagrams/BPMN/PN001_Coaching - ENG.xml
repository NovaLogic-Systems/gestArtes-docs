  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_1" name="Entartes School - Coaching Booking" processRef="Process_1" />
  </bpmn:collaboration>
  <bpmn:process id="Process_1" isExecutable="false">
