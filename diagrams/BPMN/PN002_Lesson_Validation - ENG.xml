    <bpmn:sequenceFlow id="Flow_L4a" sourceRef="Task_RegisterNoShow" targetRef="Task_ConfirmConclusion" />
    <bpmn:sequenceFlow id="Flow_L5" sourceRef="Task_ConfirmConclusion" targetRef="Task_ViewHistory" />
